    {"once": "c2_intro_seen", "do": [{"cutscene": "intro"}]}
  ],
  "cutscenes": {
    "intro": [
      {"image": "res://art/cutscenes/c2_intro.png", "color": "#e9b872", "caption": "CUT_C2_INTRO_CAPTION"},
      {"say": "CUT_C2_INTRO_1", "who": "narrator"},
      {"say": "CUT_C2_INTRO_2", "who": "sheriff"},
      {"image_clear": true}
    ]
  },
  "hotspots": [
    {
      "id": "exit_cabin",
      "name": "HS_EXIT_CABIN",
      "polygon": [[0, 150], [300, 150], [300, 700], [0, 700]],
      "walk_to": [140, 820],
      "exit": "c2_cabin",
      "exit_if": "signpost_up",
      "blocked": "SAY_SIGNPOST_FIRST"
    },
    {
      "id": "exit_lookout",
      "name": "HS_EXIT_LOOKOUT",
      "polygon": [[1650, 530], [1920, 530], [1920, 850], [1650, 850]],
      "walk_to": [1780, 820],
      "exit": "c2_lookout",
      "exit_if": "has:county_map",
      "blocked": "SAY_NEED_MAP"
    },
    {
      "id": "signpost",
      "name": "HS_SIGNPOST",
      "polygon": [[890, 310], [1095, 310], [1095, 680], [890, 680]],
      "walk_to": [1000, 780],
      "interact": [
        {"once": "signpost_up", "do": [
          {"say": "SAY_SIGNPOST_HEAVY"},
          {"say": "SAY_SIGNPOST_HELP", "who": "sheriff"},
          {"say": "SAY_SIGNPOST_UP"}
        ], "else": "SAY_SIGNPOST_DIRS"}
      ]
    },
    {
      "id": "tracks",
      "name": "HS_TRACKS",
      "polygon": [[500, 550], [880, 550], [880, 880], [500, 880]],
      "walk_to": [700, 830],
      "interact": "SAY_TRACKS_LOOK",
      "use": {
        "magnifier": [{"set": "tracks_checked"}, {"say": "SAY_TRACKS_LUPA"}]
      }
    },
    {
      "id": "grass",
      "name": "HS_GRASS",
      "polygon": [[1250, 640], [1560, 640], [1560, 780], [1250, 780]],
      "walk_to": [1200, 830],
      "interact": "SAY_GRASS_LOOK",
      "use": {
        "magnifier": [{"set": "hair_seen"}, {"say": "SAY_HAIR"}]
      }
    },
    {
      "id": "branch",
      "name": "HS_BRANCH",
      "if": "!took_branch",
      "polygon": [[960, 790], [1400, 790], [1400, 925], [960, 925]],
      "walk_to": [1180, 840],
      "interact": [{"set": "took_branch"}, {"give": "dry_branch"}, {"say": "SAY_TAKE_BRANCH"}]
    }
  ],
  "hints": [
    {"id": "cross_signpost", "if": "!signpost_up", "keys": ["HINT_CROSS_SIGN_1", "HINT_CROSS_SIGN_2", "HINT_CROSS_SIGN_3"]},
    {"id": "cross_tracks", "if": "!tracks_checked", "keys": ["HINT_CROSS_TRACKS_1", "HINT_CROSS_TRACKS_2", "HINT_CROSS_TRACKS_3"]},
    {"id": "cross_cabin", "if": "!has:county_map", "keys": ["HINT_CROSS_CABIN_1", "HINT_CROSS_CABIN_2", "HINT_CROSS_CABIN_3"]},
    {"id": "cross_lookout", "if": "has:county_map", "keys": ["HINT_CROSS_LOOKOUT_1", "HINT_CROSS_LOOKOUT_2", "HINT_CROSS_LOOKOUT_3"]}
