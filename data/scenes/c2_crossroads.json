{
  "title": "SCENE_C2_CROSSROADS",
  "background": "res://art/scenes/c2_crossroads.png",
  "background_alt": {"if": "took_branch", "path": "res://art/scenes/c2_crossroads_nobranch.png"},
  "placeholder_color": "#c99a5b",
  "walk_area": [[60, 740], [1860, 740], [1880, 900], [40, 900]],
