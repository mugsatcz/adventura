  ],
  "dialogues": {
    "cylindr": {
      "start": "hi",
      "nodes": {
        "hi": {
          "who": "cylindr",
          "text": "DLG_CYL_HI",
          "options": [
            {"text": "DLG_CYL_OPT_PRINT", "if": "has:footprint_copy & !cyl_print", "next": "print"},
            {"text": "DLG_CYL_OPT_BEARDS", "if": "has:fake_beards & !cyl_beards", "next": "beards"},
            {
              "text": "DLG_CYL_OPT_SHOE",
              "if": "has:silver_horseshoe & smith_told & !cyl_shoe",
              "next": "shoe"
            },
            {
              "text": "DLG_CYL_OPT_HROM",
              "if": "cyl_print & cyl_beards & cyl_shoe & !confronted",
              "next": "hrom"
            },
            {"text": "DLG_CYL_OPT_BYE", "next": "bye"}
          ]
        },
        "print": {"who": "cylindr", "text": "DLG_CYL_PRINT", "do": [{"set": "cyl_print"}], "next": "hi"},
        "beards": {"who": "cylindr", "text": "DLG_CYL_BEARDS", "do": [{"set": "cyl_beards"}], "next": "hi"},
        "shoe": {"who": "cylindr", "text": "DLG_CYL_SHOE", "do": [{"set": "cyl_shoe"}], "next": "hi"},
        "hrom": {"who": "cylindr", "text": "DLG_CYL_HROM", "do": [{"set": "confronted"}]},
        "bye": {"who": "cylindr", "text": "DLG_CYL_BYE"}
      }
    }
  },
  "hints": [
